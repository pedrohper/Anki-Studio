# ─── IA ──────────────────────────────────────────────────────────────────────
# No site público cada visitante informa as próprias chaves nas Configurações.
# Rodando no seu PC, você pode deixar as chaves aqui e ligar ALLOW_SERVER_KEY.
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=

# Provedor e modelo sugeridos para quem ainda não escolheu
LLM_DEFAULT_PROVIDER=deepseek
LLM_DEFAULT_MODEL=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# Só "true" no seu PC. Em deploy público deixe false, senão qualquer visitante
# gasta as suas chaves.
ALLOW_SERVER_KEY=false

# Ollama (modelos no seu computador). Só "true" no seu PC.
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# ─── Anki ────────────────────────────────────────────────────────────────────
# Só "true" no seu PC: a API repassa as chamadas ao AnkiConnect local e você não
# precisa configurar CORS no add-on.
ANKI_PROXY_ENABLED=false
ANKI_CONNECT_URL=http://127.0.0.1:8765

# ─── Outros ──────────────────────────────────────────────────────────────────
# Voz padrão do áudio (vozes neurais do Edge, sem custo)
TTS_VOICE=en-US-ChristopherNeural
# Pedidos por minuto por IP nas rotas de IA (as de rede e arquivo aceitam 3x)
RATE_LIMIT_PER_MINUTE=20
